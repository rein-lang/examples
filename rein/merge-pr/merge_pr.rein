// merge_pr.rein

import { reviewCode } from "./merge_pr/review_code";
import { fixCi } from "./merge_pr/fix";

interface Input {
  /** Does the PR change only documentation files? */
  docs_only: boolean;
  /** What is the CI status of the PR? */
  ci: "green" | "red" | "pending";
}

/**
 * Decide whether a pull request can be merged.
 */
export default function mergePr({ docs_only, ci }: Input) {
  if (docs_only) {
    return `approved`;
  }

  switch (ci) {
    case "green":
      return reviewCode;
    case "red":
      return fixCi;
    case "pending":
      return `wait for CI, then run merge_pr again`;
  }
}
