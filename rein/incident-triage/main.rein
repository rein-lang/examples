import { pageHuman } from "./page_human";
import { followRunbook } from "./follow";
import { openTicket } from "./open";

interface Alert {
  /** How severe is the alert? */
  severity: "sev1" | "sev2" | "sev3";
  /** Are customers seeing errors or downtime right now? */
  customer_impact: boolean;
  /** Does a runbook exist for this alert? */
  known_runbook: boolean;
}

/**
 * Decide how the on-call agent handles a new production alert.
 */
export default function main({
  severity,
  customer_impact,
  known_runbook,
}: Alert) {
  if (customer_impact) {
    return pageHuman;
  }

  switch (severity) {
    case "sev1":
      return pageHuman;
    case "sev2":
    case "sev3":
      if (known_runbook) {
        return followRunbook;
      }

      return openTicket;
  }
}
